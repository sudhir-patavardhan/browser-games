# ==============================================================================
# Kreeda Marketing Agent — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in the credentials for the channels you want.
# The agent will automatically work in "Draft / Offline Mode" if keys are missing.

# ------------------------------------------------------------------------------
# 1. AI Core (Required for autonomous generation and lead analysis)
# Get your API key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# ------------------------------------------------------------------------------
# 2. General Settings
# ------------------------------------------------------------------------------
# Mode: "draft" (creates posts in local queue for review) or "live" (auto-publishes)
MARKETING_MODE=draft
BASE_URL=https://kreeda.games
REPO_URL=https://github.com/sudhir-patavardhan/browser-games

# ------------------------------------------------------------------------------
# 3. Twitter / X Publishing
# Create a developer app at: https://developer.x.com/
# Ensure App Permissions are set to: "Read and Write"
# ------------------------------------------------------------------------------
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# ------------------------------------------------------------------------------
# 4. Reddit Publishing & Scouting
# Create an app at: https://www.reddit.com/prefs/apps (select "script")
# ------------------------------------------------------------------------------
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password
REDDIT_USER_AGENT=KreedaGrowthAgent/1.0 by your_reddit_username

# ------------------------------------------------------------------------------
# 5. Discord Webhooks (For community announcements or team notifications)
# Server Settings -> Integrations -> Webhooks -> New Webhook
# ------------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ------------------------------------------------------------------------------
# 6. Universal Webhooks / Buffer / Zapier / Make (Instagram, TikTok, LinkedIn)
# ------------------------------------------------------------------------------
GENERIC_WEBHOOK_URL=https://hook.eu1.make.com/...
BUFFER_ACCESS_TOKEN=your_buffer_access_token
BUFFER_PROFILE_IDS=profile_id_1,profile_id_2

# ------------------------------------------------------------------------------
# 7. Dev.to / Hashnode (For Tech Architecture & Dev Logs)
# Dev.to: Settings -> Extensions -> Generate API Key
# ------------------------------------------------------------------------------
DEVTO_API_KEY=your_devto_api_key
HASHNODE_ACCESS_TOKEN=your_hashnode_token
HASHNODE_PUBLICATION_ID=your_publication_id

# ------------------------------------------------------------------------------
# 8. GitHub Integration (For committing generated artifacts & status reports)
# ------------------------------------------------------------------------------
GITHUB_TOKEN=your_github_personal_access_token

# ------------------------------------------------------------------------------
# 9. X Ads (paid campaigns, run by the agent under a hard spend policy)
# Uses the same Twitter OAuth 1.0a keys above, but the developer app must also
# be approved for the Ads API: https://docs.x.com/forms/ads-api-access
# Account ID is in the Ads Manager URL: ads.x.com/manager/<ACCOUNT_ID>/...
# ------------------------------------------------------------------------------
X_ADS_ACCOUNT_ID=your_ads_account_id
# Optional: pin a specific card; otherwise the account's active card is used.
X_ADS_FUNDING_INSTRUMENT_ID=
# The account bills in the card's currency. If it isn't USD, set the rate
# (local units per 1 USD) or launches are refused.
X_ADS_CURRENCY=USD
X_ADS_USD_TO_LOCAL_RATE=1
# Hard ceilings (USD). These can be lowered here but never raised above 10 / 25.
X_ADS_MAX_DAILY_PER_CAMPAIGN_USD=10
X_ADS_MAX_TOTAL_DAILY_USD=25
# Days a campaign runs before analytics decide whether to keep or pause it.
X_ADS_TRIAL_DAYS=2
X_ADS_MAX_ACTIVE_CAMPAIGNS=2

# Conversion API (server-side, separate from the Ads API above — no app
# approval needed). Pixel id + token come from Ads Manager > Events manager >
# your pixel > "Set up Conversion API".
X_PIXEL_ID=your_pixel_id
X_PIXEL_TOKEN=your_pixel_token
