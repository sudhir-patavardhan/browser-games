# Kreeda marketing — the environment a Cycle runs in.
#
# In the cloud these are the "Browser Games" environment's variables
# (env_011FxiY73spRKKNNboQdie8B). Locally, copy this file to marketing/.env so
# every command runs identically on the CMO's machine. Nothing here is ever
# committed: .env is git-ignored.
#
# `node cli.js smoke` reports which of these are present, which are missing,
# and what the system loses for each one that is.

# --- X Channel: publishing Posts -------------------------------------------
# developer.x.com -> your app -> Keys and tokens. The access token must be
# Read+Write. Regenerate it after any permission change, or publishing fails
# with a 403 that looks like an approval problem.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
# Read-only, app-level. The Analyst reads impressions and link clicks with it.
TWITTER_BEARER_TOKEN=

# --- Facebook Channel: publishing Posts ------------------------------------
# A long-lived Page token, which does not expire while the CMO is an admin of
# the Page. Do not paste a Graph API Explorer user token here — those last an
# hour. `node cli.js fb token` exchanges one for the Page token to put here.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
# Only `fb token` and `fb preflight` need these two: minting a long-lived Page
# token and inspecting one both have to prove they are the app. Publishing a
# Post does not, so they can be left out of the cloud environment.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- The Creative ----------------------------------------------------------
# aistudio.google.com. Without it the Creative cannot fill a Post, and the
# Producer leaves the Post as a Draft rather than publishing fallback copy.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# --- Players: the north-star metric ----------------------------------------
# The Analyst counts Players (the played_30s event) per Game, per Post and per
# Campaign from the GA4 Data API. GA4_SA_KEY is the whole service-account JSON
# key as one value; that service account needs Viewer on the property.
GA4_PROPERTY_ID=548072389
GA4_SA_KEY=

# --- Campaigns (paid, Phase 4) ---------------------------------------------
# The Caps are frozen in code at $10/day per Campaign and $25/day in total.
# The two settings below can only lower them; a larger number is ignored.
X_ADS_ACCOUNT_ID=
X_ADS_CURRENCY=USD
# Local currency units per 1 USD — 1 for a USD-billed account, ~84 for INR.
X_ADS_USD_TO_LOCAL_RATE=1
X_ADS_FUNDING_INSTRUMENT_ID=
X_ADS_MAX_DAILY_PER_CAMPAIGN_USD=10
X_ADS_MAX_TOTAL_DAILY_USD=25
X_ADS_MAX_ACTIVE_CAMPAIGNS=2
# The X pixel, so a Player an ad brought is attributed to its Campaign.
X_PIXEL_ID=
X_PIXEL_TOKEN=

# --- The Producer's own access ---------------------------------------------
# Pushes marketing-state, opens and reads the Review, uploads Assets to the
# media release. Locally, `gh auth login` can stand in for this.
GH_TOKEN=
# Where Alerts and the weekly Briefing are emailed.
CMO_EMAIL=

# --- Cycle behaviour -------------------------------------------------------
# draft: nothing leaves this machine. live: the Producer publishes approved
# Posts and launches approved Campaigns. A merged Review is still required in
# both; there is no autopublish.
MARKETING_MODE=draft
BASE_URL=https://kreeda.games
